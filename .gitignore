# AI agent tooling
# .claude/settings.json (team config) and .claude/agents/ would be committed,
# but this project has neither — only the personal-override file exists.
.claude/settings.local.json
# .codex/ and .agents/ are empty; ignore them so accidental state files don't slip in.
.codex/
.agents/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (tests use the built-in runner; no deps, but just in case)
node_modules/
npm-debug.log*

# Local Chromium profiles / scratch used when regenerating the example PDF
.chromium-profile/
.wrangler/
*.tmp

# Generated example PDF — regenerate from medrol-taper.html, don't commit.
